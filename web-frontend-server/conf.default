server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 20m;

  # Docker DNS: tu resolve lai khi container backend bi recreate
  resolver 127.0.0.11 valid=10s ipv6=off;

  # Mo rong: cho portal (trang chu) goi API khi truy cap truc tiep :8080/:8082
  location /api/ {
    set $app_upstream application-backend-server;
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$app_upstream:8081;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Mo rong 10: cho biet request duoc phuc vu boi web server nao
  add_header X-Served-By $hostname always;

  location / { try_files $uri $uri/ =404; }

  # Mo rong 7: endpoint de Prometheus scrape (job 'web')
  location = /metrics {
    default_type text/plain;
    charset utf-8;
    try_files $uri =404;
  }

  location ^~ /blog/ {
    alias /usr/share/nginx/html/blog/;
    index index.html;
    autoindex off;
  }

  # Mo rong 10: hien thi ten web server o goc phai (de thay round robin)
  sub_filter_once on;
  sub_filter '</body>' '<div style="position:fixed;right:14px;bottom:14px;z-index:9999;padding:6px 11px;border-radius:8px;background:rgba(20,14,38,.85);color:#e6dcff;font:12px/1.4 system-ui,sans-serif;border:1px solid rgba(195,157,245,.45);box-shadow:0 8px 20px -12px #000">Served by <b>$hostname</b></div></body>';
}
